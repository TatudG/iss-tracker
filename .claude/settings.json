{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[(now|todate), (.session_id // \"-\"), (.cwd // \"-\"), (.tool_input.skill // \"?\"), (.tool_input.args // \"\")] | @tsv' >> ~/.claude/skill-aufrufe.log 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Skill-Aufruf wird protokolliert"
          }
        ]
      }
    ]
  }
}
